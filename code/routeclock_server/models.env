# 在 Linux Bash 中用 source models.env 加载，随后可进入任一子项目运行原生脚本。
_routeclock_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export HF_HOME="$_routeclock_root/weights/huggingface"
export HF_HUB_OFFLINE=1
_routeclock_hub="$HF_HOME/hub/models--amazon--chronos-2"
export CHRONOS_DIR="$_routeclock_hub/snapshots/$(cat "$_routeclock_hub/refs/main")"
export ROUTECLOCK_TABPFN_CHECKPOINT="$_routeclock_root/weights/tabpfn/tabpfn-v2.5-regressor-v2.5_default.ckpt"
unset _routeclock_root _routeclock_hub
